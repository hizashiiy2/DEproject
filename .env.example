# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/app.db

# On Vercel, DATABASE_PATH is ignored; the app uses /tmp/deproject.db via sql.js (writable in serverless).
# Data in /tmp is ephemeral per function instance — fine for demos; use Turso/Postgres for production persistence.
# Set Node.js 22.x in Vercel project settings (see .node-version).
