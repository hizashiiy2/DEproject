# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/app.db

# Deployment: use a host that runs one long-lived container (Render, Railway,
# Fly.io) so the SQLite file is shared across requests. See render.yaml.
# On the free plan the container filesystem resets on restart (the demo data
# re-seeds); attach a persistent disk for permanent storage.
#
# Do NOT deploy to Vercel: its per-request serverless model gives each instance
# its own temporary filesystem, so created/edited data is lost between requests.
