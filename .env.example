# Path to the SQLite database file (created automatically if missing)
DATABASE_PATH=./data/app.db

# On Vercel, the app automatically uses /tmp/deproject.db (writable in serverless).
# Data in /tmp is ephemeral per function instance — fine for demos; use Turso/Postgres for production persistence.
# Vercel must use Node.js 22+ (see package.json engines) for built-in node:sqlite.
